{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@resgine/layout": ["./packages/layout/src/index.ts"],
      "@resgine/core": ["./packages/core/src/index.ts"],
      "@resgine/schema": ["./packages/schema/src/index.ts"],
      "@resgine/validator": ["./packages/validator/src/index.ts"],
      "@resgine/pdf-renderer": ["./packages/pdf-renderer/src/index.ts"],
      "@resgine/theme-modern": ["./packages/theme-modern/src/index.ts"]
    }
  }
}
