            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "projects"
              },
              "title": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "properties": {
                  "items": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Project name"
                        },
                        "url": {
                          "type": "string",
                          "description": "Project URL"
                        },
                        "description": {
                          "type": "string",
