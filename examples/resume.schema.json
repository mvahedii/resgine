                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Link label, e.g. \"GitHub\""
                        },
                        "url": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Fully-qualified URL"
                        }
                      },
                      "required": [
                        "label",
                        "url"
                      ],
                      "additionalProperties": false
                    },
                    "description": "External profile links"
                  }
                },
                "required": [
                  "name",
                  "headline",
                  "email"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "summary"
              },
              "title": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "properties": {
                  "body": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Professional summary"
                  }
