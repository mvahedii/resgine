                        },
                        "location": {
                          "type": "string",
                          "description": "Job location"
                        },
                        "highlights": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": "Accomplishment bullet points"
                        }
                      },
                      "required": [
                        "role",
                        "company",
                        "period"
                      ],
                      "additionalProperties": false
