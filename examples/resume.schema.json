                      "type": "object",
                      "properties": {
                        "role": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Job title"
                        },
                        "company": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Employer name"
                        },
                        "period": {
                          "type": "string",
                          "minLength": 1,
