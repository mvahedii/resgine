    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "personal-info"
              },
              "title": {
                "type": "string"
              },
              "data": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "FirstName and LastName"
                  },
                  "headline": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Professional headline, e.g. \"Senior Software Engineer\""
                  },
                  "email": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Contact email address"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Contact phone number"
                  },
                  "location": {
                    "type": "string",
                    "description": "City, country"
                  },
                  "links": {
                    "type": "array",
