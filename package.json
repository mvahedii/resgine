{
  "name": "resgine",
  "version": "0.1.0",
  "private": true,
  "description": "A schema-driven, themeable, JSON-based resume rendering engine",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "resume": "tsx packages/cli/src/index.ts",
    "dev:example": "tsx packages/cli/src/index.ts build examples/resume.json -o examples/resume.pdf",
    "dev:schema": "tsx packages/cli/src/index.ts schema -o examples/resume.schema.json"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.1.3+sha512.c85357fe17ca12dd23dd7071822666dfd7e3cb76fe214e3370b5ea2fb34f2a231185509b63e717f3cd0acb38dd3f8d82bcd5e8172400ae678b70ea4fbed0896d"
}
